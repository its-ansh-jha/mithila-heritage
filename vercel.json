{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/rooms",
      "destination": "/rooms/index.html"
    },
    {
      "source": "/rooms/heritage-classic",
      "destination": "/rooms/heritage-classic/index.html"
    },
    {
      "source": "/rooms/heritage-deluxe",
      "destination": "/rooms/heritage-deluxe/index.html"
    },
    {
      "source": "/rooms/royal-premium",
      "destination": "/rooms/royal-premium/index.html"
    },
    {
      "source": "/rooms/maharaja-suite",
      "destination": "/rooms/maharaja-suite/index.html"
    },
    {
      "source": "/restaurant",
      "destination": "/restaurant/index.html"
    },
    {
      "source": "/banquet",
      "destination": "/banquet/index.html"
    },
    {
      "source": "/about",
      "destination": "/about/index.html"
    },
    {
      "source": "/gallery",
      "destination": "/gallery/index.html"
    },
    {
      "source": "/contact",
      "destination": "/contact/index.html"
    },
    {
      "source": "/((?!images/|assets/|favicon.svg|robots.txt|sitemap.xml).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://www.mithilaheritage.in/$1",
      "permanent": true,
      "has": [
        {
          "type": "host",
          "value": "mithilaheritage.in"
        }
      ]
    },
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/rooms.php",
      "destination": "/rooms",
      "permanent": true
    },
    {
      "source": "/heritage-classic-rooms.php",
      "destination": "/rooms/heritage-classic",
      "permanent": true
    },
    {
      "source": "/heritage-deluxe-room.php",
      "destination": "/rooms/heritage-deluxe",
      "permanent": true
    },
    {
      "source": "/royal-premium-Deluxe-room.php",
      "destination": "/rooms/royal-premium",
      "permanent": true
    },
    {
      "source": "/maharaja-suite-room.php",
      "destination": "/rooms/maharaja-suite",
      "permanent": true
    },
    {
      "source": "/grand-banquet-hall.php",
      "destination": "/banquet",
      "permanent": true
    },
    {
      "source": "/rooftop-restaurant.php",
      "destination": "/restaurant",
      "permanent": true
    },
    {
      "source": "/about-hotel.php",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/gallery.php",
      "destination": "/gallery",
      "permanent": true
    },
    {
      "source": "/contact-us.php",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/reservation.php",
      "destination": "/book",
      "permanent": true
    }
  ]
}
